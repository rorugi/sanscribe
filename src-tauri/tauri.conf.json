{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sanscribe",
  "version": "0.2.0",
  "identifier": "com.sanscribe.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sanscribe – Settings",
        "width": 620,
        "height": 780,
        "minWidth": 480,
        "minHeight": 520,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Sanscribe",
    "category": "Utility",
    "shortDescription": "Devanagari ↔ IAST transliteration with a global hotkey",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBOTlBMjA0OUFFNDNDOUIKUldTYlBPU2FCS0tadW1nWTZQWDdtbEpqa05XdUxucjRQakhtVzdWZkxnc3B1R1JIc2ordVhPNzkK",
      "endpoints": [
        "https://github.com/rorugi/sanscribe/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}